API_KEY=dev-local-troque-esta-chave

# ---------------------------------------------------------------------------
# Atendimento automatico (simulador de WhatsApp em /atendimento)
# ---------------------------------------------------------------------------
NOME_NEGOCIO=ConnectTV

# Link do aplicativo Android na Play Store. Se vazio, o agente avisa que o
# atendente enviara o link na ativacao.
LINK_APP_ANDROID=https://play.google.com/store/apps/details?id=com.linktunnel

# Aplicativo de IPTV usado quando o aparelho nao estiver no mapa por marca/modelo.
APP_IPTV_PADRAO=IBO Player

# Numero que recebe o alerta de transferencia (formato 55DDDNUMERO).
ALERTA_WHATSAPP=5511942432179

# Opcional: webhook para receber o alerta em JSON (n8n, Zapier, Make...).
ALERTA_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# IA compativel com OpenAI (Gemini, OpenAI, DeepSeek, Groq, Ollama...)
# Exemplo Gemini (o padrao abaixo ja esta pronto: falta so a chave):
#   IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   IA_API_KEY=sua-chave
#   IA_MODELO=gemini-3.5-flash
# Sem IA_API_KEY, o agente funciona no modo roteirizado (respostas fixas).
# ---------------------------------------------------------------------------
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_API_KEY=
IA_MODELO=gemini-3.5-flash
IA_TIMEOUT=25

# Pausa variavel antes de responder (simula digitacao humana / anti-ban).
ATENDIMENTO_PAUSA_ATIVA=1
ATENDIMENTO_PAUSA_MIN=0.8
ATENDIMENTO_PAUSA_MAX=2.5
ATENDIMENTO_PAUSA_TETO=6.0
ATENDIMENTO_PAUSA_POR_CARACTERE=0.008

# Quando a IA nao sabe a resposta:
#   0 = avisa que vai confirmar, registra a duvida e continua o atendimento (padrao)
#   1 = transfere na hora para um humano
ATENDIMENTO_TRANSFERIR_DUVIDA=0

# Caminhos opcionais (o padrao ja aponta para a pasta dados/).
# ARQUIVO_CONHECIMENTO=D:/planilhas/ia atendimento/dados/conhecimento.json
# ARQUIVO_APLICATIVOS=D:/planilhas/ia atendimento/dados/aplicativos.json
