# Copie este arquivo para .env e preencha os valores.

NOME_NEGOCIO=ConnectTV
LINK_APP_ANDROID=
APP_IPTV_PADRAO=

# Alerta de transferencia para atendimento humano
ALERTA_WHATSAPP=5511958881962
ALERTA_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# IA - Google Gemini
# ---------------------------------------------------------------------------
# Crie a chave no Google AI Studio e cole apenas no seu arquivo .env local.
# NAO envie a chave para o GitHub.
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
IA_API_KEY=SUA_CHAVE_DO_GOOGLE_AI_STUDIO
IA_MODELO=gemini-flash-lite-latest
IA_TIMEOUT=20

# IA reserva: Ollama no seu computador
# Instale o Ollama e baixe um modelo, por exemplo: ollama pull llama3.1:8b
IA_FALLBACK_BASE_URL=http://localhost:11434/v1
IA_FALLBACK_API_KEY=
IA_FALLBACK_MODELO=llama3.1:8b

ARQUIVO_APLICATIVOS=dados/aplicativos.json
ARQUIVO_CONHECIMENTO=dados/conhecimento.json

ATENDIMENTO_PAUSA_ATIVA=true
ATENDIMENTO_PAUSA_MIN=0.8
ATENDIMENTO_PAUSA_MAX=2.5
ATENDIMENTO_PAUSA_TETO=6.0
ATENDIMENTO_PAUSA_POR_CARACTERE=0.008

ATENDIMENTO_TRANSFERIR_DUVIDA=false